{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run ASP.NET AttackShield API",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"run",
				"--project",
				"src/AttackShield.API/AttackShield.API.csproj",
				"--launch-profile",
				"http"
			],
			"isBackground": true,
			"problemMatcher": [
				"$msCompile"
			],
			"group": "build"
		}
	]
}